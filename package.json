{
  "name": "werewolf-game",
  "version": "1.0.0",
  "description": "Game Ma Sói Online Đa Người Chơi Thời Gian Thực",
  "main": "server/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "node server/test/run_all_tests.js"
  },
  "keywords": [
    "werewolf",
    "ma-soi",
    "multiplayer",
    "game",
    "socket.io",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
